# RANDA.MKCOOL security guardrails
# Never commit secrets, signing keys, local credentials, customer data, or generated private files.

# Environment / secrets
.env
.env.*
!.env.example
.envrc
*.pem
*.p12
*.pfx
*.key
*.secret
*.kdbx
secrets/
private/
credentials/
credentials*.json
client_secret*.json
.netrc
.pypirc
.npmrc
id_rsa*
id_ed25519*

# Private/customer/project data
personal-data/
customer-data/
private-data/
exports/private/
backups/private/
*.sqlite
*.sqlite3
*.db

# Android signing / Firebase admin
*.jks
*.keystore
key.properties
service-account*.json
firebase-admin*.json

# Supabase / Stripe backend secrets
.supabase/
supabase/.temp/

# Local tooling / IDE
.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# Build outputs
build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies

# Logs / archives that can contain data
*.log
*.bak
*.backup
*.zip
